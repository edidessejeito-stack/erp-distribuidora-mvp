# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# PORT: Porta do servidor Express Node.js
PORT="3000"

# CONFIGURAÇÃO DE BANCO DE DADOS MYSQL 9 (EASYPANEL)
# URL de conexão completa:
DATABASE_URL="mysql://erpusr:ErpPwd1@dados_erp:3306/erpdb"

# Ou parâmetros individuais:
DB_HOST="dados_erp"
DB_PORT="3306"
DB_NAME="erpdb"
DB_USER="erpusr"
DB_PASSWORD="ErpPwd1"
